# Variables for the GitHub Environment "sandbox". Copy to .env.var.sandbox (ignored by git), fill in, then:
#   gh variable set -f .env.var.sandbox --env sandbox -R the-shards/landing
AWS_REGION=us-east-1
S3_BUCKET=<BUCKET_NAME>
CLOUDFRONT_DISTRIBUTION_ID=<DISTRIBUTION_ID>
VITE_API_BASE=https://api.sandbox.theshardsgame.com
